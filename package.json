{
  "name": "procurely",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "stack:up": "docker compose up --build -d --wait",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v && docker compose up --build -d --wait"
  }
}
