{
  "name": "@procurely/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns /test/http/",
    "test:http": "pnpm db:reset && jest --config jest.http.config.json --runInBand",
    "db:reset": "tsx --env-file=db.env scripts/db-reset.ts && node --env-file=db.env node_modules/prisma/build/index.js migrate deploy && node --env-file=db.env node_modules/prisma/build/index.js db seed",
    "rls:audit": "tsx --env-file=db.env scripts/rls-audit.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "@procurely/shared-types": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testRegex": "test/.*\\.spec\\.ts$"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
