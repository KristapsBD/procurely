  "info": {
    "title": "Procurely API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "DevLoginRequest": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string"
          }
        },
        "required": [
          "personId"
        ]
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Bearer token for the Authorization header."
          },
          "person": {
            "$ref": "#/components/schemas/Person"
          }
        },
        "required": [
          "token",
          "person"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "REQUESTER",
          "APPROVER",
          "BUYER",
          "ADMIN"
        ]
      },
      "CompanyMembership": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "companyId": {
            "type": "string"
          },
          "companyName": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "companyId",
          "companyName",
          "currency"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "memberships": {
            "description": "Active memberships only. Empty for a person who belongs to no company.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanyMembership"
            }
          },
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "memberships",
          "id",
          "email",
          "name"
        ]
      },
      "CostCenter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "companyId": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "companyId",
          "code",
          "name"
        ]
      },
      "CreateCostCenterRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "UpdateCostCenterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "Member": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "id": {
            "type": "string",
            "description": "The membership id (not the person id)."
          },
          "personId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "id",
          "personId",
          "email",
          "name",
          "active"
        ]
      },
      "InviteMemberRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name for a new person; defaults to the part of the email before the @."
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "email"
        ]
      },
      "UpdateMemberRequest": {
        "type": "object",
        "properties": {
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "AuditEntry": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Free-form details of the action; null when there are none."
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601 timestamp.",
            "format": "date-time"
          },
          "id": {
            "type": "string"
          },
          "actorPersonId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          }
        },
        "required": [
          "entityId",
          "details",
          "createdAt",
          "id",
          "actorPersonId",
          "action",
          "entityType"
        ]
      }
    }
  }
}
