          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect back to the app."
          }
        },
        "summary": "Google's redirect URI: redirects back to the app's return address with `?code=` (a\nhandoff code for POST /auth/google/session) or `?error=` (cancelled, rejected, conflict,\nfailed).",
