  "info": {
    "title": "Procurely API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "AuthOptions": {
        "type": "object",
        "properties": {
          "devLogin": {
            "type": "boolean",
            "description": "The dev-only login (development and test configurations only)."
          },
          "google": {
            "type": "boolean",
            "description": "Google sign-in, when it is configured."
          }
        },
        "required": [
