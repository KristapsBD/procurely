generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the restricted API role (subject to RLS).
// DIRECT_URL is the owner role used by migrations, the seed and the RLS audit.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  REQUESTER
  APPROVER
  BUYER
  ADMIN
}

model Company {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  /// ISO 4217 code. One currency per company; amounts are integer minor units.
  currency    String       @db.Char(3)
  memberships Membership[]
  costCenters CostCenter[]
  auditLog    AuditLog[]

  @@map("companies")
}

model Person {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String       @unique
  name        String
  memberships Membership[]
  auditLog    AuditLog[]

  @@map("people")
}

model Membership {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  personId  String  @map("person_id") @db.Uuid
  role      Role
  active    Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id])
  person    Person  @relation(fields: [personId], references: [id])

  @@unique([companyId, personId])
  @@index([personId])
  @@map("memberships")
}

model CostCenter {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  code      String
  name      String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("cost_centers")
}

/// Append-only: the API role can insert and select (admins only) but never update or delete.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  actorPersonId String   @map("actor_person_id") @db.Uuid
  /// Dotted verb, e.g. "member.invited".
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company       Company  @relation(fields: [companyId], references: [id])
  actor         Person   @relation(fields: [actorPersonId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_log")
}
