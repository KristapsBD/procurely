generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL is the restricted API role (subject to RLS).
// DIRECT_URL is the owner role used by migrations, the seed and the RLS audit.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  REQUESTER
  APPROVER
  BUYER
  ADMIN
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

/// The roles an approval rule may require. Requesters and buyers never approve.
enum ApproverRole {
  APPROVER
  ADMIN
}

/// Who decides a requisition, fixed when it leaves DRAFT: the role of the applicable rule, nobody
/// (under every threshold: approved on submit), or an admin (the company has no rules).
enum ApprovalRoute {
  APPROVER
  ADMIN
  UNDER_THRESHOLD
  NO_RULES
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

model Company {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  /// ISO 4217 code. One currency per company; amounts are integer minor units.
  currency       String                @db.Char(3)
  memberships    Membership[]
  costCenters    CostCenter[]
  suppliers      Supplier[]
  catalogItems   CatalogItem[]
  requisitions   Requisition[]
  auditLog       AuditLog[]
  approvalRules  ApprovalRule[]
  decisions      RequisitionDecision[]
  pushDevices    PushDevice[]
  purchaseOrders PurchaseOrder[]

  @@map("companies")
}

model Person {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String                 @unique
  name           String
  /// Google's stable subject identifier, set at the first Google sign-in. Null until then.
  googleSub      String?                @unique @map("google_sub")
  memberships    Membership[]
  requisitions   Requisition[]
  auditLog       AuditLog[]
  decisions      RequisitionDecision[]
  pushDevices    PushDevice[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  closures       PurchaseOrderClosure[]

  @@map("people")
}

model Membership {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  personId  String  @map("person_id") @db.Uuid
  role      Role
  active    Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id])
  person    Person  @relation(fields: [personId], references: [id])

  @@unique([companyId, personId])
  @@index([personId])
  @@map("memberships")
}

model CostCenter {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  code         String
  name         String
  company      Company       @relation(fields: [companyId], references: [id])
  requisitions Requisition[]

  @@unique([companyId, code])
  // Target of the company-matching foreign key from requisitions.
  @@unique([companyId, id])
  @@map("cost_centers")
}

/// A company the business buys from. Suppliers do not log in. Never deleted: an inactive
/// supplier keeps its history but cannot be chosen for new work.
model Supplier {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  name           String
  active         Boolean         @default(true)
  company        Company         @relation(fields: [companyId], references: [id])
  catalogItems   CatalogItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, name])
  // Target of the company-matching foreign key from catalog_items.
  @@unique([companyId, id])
  @@map("suppliers")
}

/// Something the company buys from one supplier at an agreed price.
model CatalogItem {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  supplierId         String              @map("supplier_id") @db.Uuid
  name               String
  /// Agreed unit price in integer minor units of the company currency (cents, öre).
  unitPriceMinor     Int                 @map("unit_price_minor")
  company            Company             @relation(fields: [companyId], references: [id])
  // Composite key: the supplier must belong to the same company as the item.
  supplier           Supplier            @relation(fields: [companyId, supplierId], references: [companyId, id])
  requisitionLines   RequisitionLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([companyId, supplierId, name])
  // Target of the company-matching foreign key from requisition_lines.
  @@unique([companyId, id])
  @@map("catalog_items")
}

/// A request to buy catalog items, charged to a cost center. Never deleted: cancel instead.
/// Its total is the sum of its line amounts, computed on read.
model Requisition {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String                @map("company_id") @db.Uuid
  requesterPersonId String                @map("requester_person_id") @db.Uuid
  /// Null while a draft has none. The foreign key also covers company_id.
  costCenterId      String?               @map("cost_center_id") @db.Uuid
  justification     String                @default("")
  status            RequisitionStatus     @default(DRAFT)
  /// Null while a draft, and on a draft that was cancelled.
  approvalRoute     ApprovalRoute?        @map("approval_route")
  /// What the requester reads about the outcome: the approver's comment, the rejection reason,
  /// or why it was approved automatically.
  decisionNote      String?               @map("decision_note")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  company           Company               @relation(fields: [companyId], references: [id])
  requester         Person                @relation(fields: [requesterPersonId], references: [id])
  costCenter        CostCenter?           @relation(fields: [companyId, costCenterId], references: [companyId, id], onDelete: Restrict)
  lines             RequisitionLine[]
  /// At most one: requisition_id is unique.
  decisions         RequisitionDecision[]
  /// At most one: purchase_orders.requisition_id is unique.
  purchaseOrders    PurchaseOrder[]

  @@unique([companyId, id])
  @@index([companyId, requesterPersonId])
  @@map("requisitions")
}

/// One catalog item on a requisition. The unit price is copied from the catalog when the
/// requisition is saved, so a later price change does not alter it.
model RequisitionLine {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  requisitionId  String      @map("requisition_id") @db.Uuid
  /// Order of the line within its requisition, from 0.
  position       Int
  catalogItemId  String      @map("catalog_item_id") @db.Uuid
  quantity       Int
  unitPriceMinor Int         @map("unit_price_minor")
  /// quantity * unitPriceMinor, enforced by a check constraint.
  amountMinor    Int         @map("amount_minor")
  requisition    Requisition @relation(fields: [companyId, requisitionId], references: [companyId, id])
  catalogItem    CatalogItem @relation(fields: [companyId, catalogItemId], references: [companyId, id])

  @@unique([requisitionId, position])
  @@map("requisition_lines")
}

/// "From this amount on, this role approves." Thresholds are inclusive. Never updated: a change
/// is a delete plus a create.
model ApprovalRule {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  /// Integer minor units of the company currency, zero or more.
  thresholdMinor Int          @map("threshold_minor")
  requiredRole   ApproverRole @map("required_role")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  company        Company      @relation(fields: [companyId], references: [id])

  @@unique([companyId, thresholdMinor])
  @@map("approval_rules")
}

/// A person's approval or rejection of a submitted requisition. Append-only, one per requisition.
/// An automatic approval has none.
model RequisitionDecision {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  requisitionId String          @unique @map("requisition_id") @db.Uuid
  actorPersonId String          @map("actor_person_id") @db.Uuid
  outcome       DecisionOutcome
  /// Optional on an approval, the required reason on a rejection.
  comment       String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  company       Company         @relation(fields: [companyId], references: [id])
  requisition   Requisition     @relation(fields: [companyId, requisitionId], references: [companyId, id])
  actor         Person          @relation(fields: [actorPersonId], references: [id])

  @@map("requisition_decisions")
}

/// A buyer's order of an approved requisition from one supplier. Never changed or deleted. Its
/// total is the sum of its line amounts, computed on read.
model PurchaseOrder {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  /// Unique: a requisition converts once.
  requisitionId     String                 @unique @map("requisition_id") @db.Uuid
  supplierId        String                 @map("supplier_id") @db.Uuid
  createdByPersonId String                 @map("created_by_person_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  company           Company                @relation(fields: [companyId], references: [id])
  requisition       Requisition            @relation(fields: [companyId, requisitionId], references: [companyId, id])
  supplier          Supplier               @relation(fields: [companyId, supplierId], references: [companyId, id])
  createdBy         Person                 @relation(fields: [createdByPersonId], references: [id])
  lines             PurchaseOrderLine[]
  receipts          GoodsReceipt[]
  /// At most one: purchase_order_closures.purchase_order_id is unique.
  closures          PurchaseOrderClosure[]

  @@unique([companyId, id])
  @@index([companyId, createdAt])
  @@map("purchase_orders")
}

/// One catalog item on a purchase order. Unlike a requisition line, the unit price is the
/// buyer's to set (it starts from the requisition line's price).
model PurchaseOrderLine {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  /// Order of the line within its purchase order, from 0.
  position        Int
  catalogItemId   String             @map("catalog_item_id") @db.Uuid
  quantity        Int
  unitPriceMinor  Int                @map("unit_price_minor")
  /// quantity * unitPriceMinor, enforced by a check constraint.
  amountMinor     Int                @map("amount_minor")
  purchaseOrder   PurchaseOrder      @relation(fields: [companyId, purchaseOrderId], references: [companyId, id])
  catalogItem     CatalogItem        @relation(fields: [companyId, catalogItemId], references: [companyId, id])
  receiptLines    GoodsReceiptLine[]

  @@unique([purchaseOrderId, position])
  // Target of the foreign key that keeps a receipt line on its own order.
  @@unique([purchaseOrderId, id])
  @@map("purchase_order_lines")
}

/// One delivery a buyer confirmed against a purchase order. Never changed or deleted: a mistake
/// is corrected by a later receipt whose line has a negative quantity.
model GoodsReceipt {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  purchaseOrderId    String             @map("purchase_order_id") @db.Uuid
  receivedByPersonId String             @map("received_by_person_id") @db.Uuid
  receivedAt         DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  purchaseOrder      PurchaseOrder      @relation(fields: [companyId, purchaseOrderId], references: [companyId, id])
  receivedBy         Person             @relation(fields: [receivedByPersonId], references: [id])
  lines              GoodsReceiptLine[]

  // Target of the foreign key that keeps a receipt line on its receipt's company and order.
  @@unique([companyId, purchaseOrderId, id])
  @@index([purchaseOrderId, receivedAt])
  @@map("goods_receipts")
}

/// Quantity received on one purchase order line. Positive for a delivery, negative (with a note)
/// for a correction. Check constraints and a trigger keep the line's net total between zero and
/// the ordered quantity.
model GoodsReceiptLine {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String            @map("company_id") @db.Uuid
  goodsReceiptId      String            @map("goods_receipt_id") @db.Uuid
  purchaseOrderId     String            @map("purchase_order_id") @db.Uuid
  purchaseOrderLineId String            @map("purchase_order_line_id") @db.Uuid
  quantity            Int
  /// Optional: damage, shortfall, why a correction. Required when the quantity is negative.
  note                String?
  // The receipt belongs to the same company and the same order as the line.
  receipt             GoodsReceipt      @relation(fields: [companyId, purchaseOrderId, goodsReceiptId], references: [companyId, purchaseOrderId, id])
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderId, purchaseOrderLineId], references: [purchaseOrderId, id])

  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

/// A buyer's record that an order is complete. Exists only for a fully received order and is
/// never removed; it is what moves the order to CLOSED.
model PurchaseOrderClosure {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  purchaseOrderId  String        @unique @map("purchase_order_id") @db.Uuid
  closedByPersonId String        @map("closed_by_person_id") @db.Uuid
  closedAt         DateTime      @default(now()) @map("closed_at") @db.Timestamptz(3)
  purchaseOrder    PurchaseOrder @relation(fields: [companyId, purchaseOrderId], references: [companyId, id])
  closedBy         Person        @relation(fields: [closedByPersonId], references: [id])

  @@map("purchase_order_closures")
}

/// Append-only: the API role can insert and select (admins only) but never update or delete.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  actorPersonId String   @map("actor_person_id") @db.Uuid
  /// Dotted verb, e.g. "member.invited".
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Insertion order; breaks ties between entries written in one transaction.
  seq           BigInt   @unique @default(autoincrement())
  company       Company  @relation(fields: [companyId], references: [id])
  actor         Person   @relation(fields: [actorPersonId], references: [id])

  @@index([companyId, createdAt])
  @@map("audit_log")
}

/// The Expo push token of a phone, bound to the person and the one company they act in on it. A
/// token is a device, so it is unique: registering it again moves it. Written only by the
/// register_push_device() function.
model PushDevice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  token     String   @unique
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id])
  person    Person   @relation(fields: [personId], references: [id])

  @@index([companyId, personId])
  @@map("push_devices")
}
