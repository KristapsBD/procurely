# Local development defaults (docker compose db on the host port). Real environment
# variables take precedence; scripts load this with `node --env-file`.
# DATABASE_URL: restricted API role, subject to RLS.
DATABASE_URL=postgresql://procurely_api:procurely_api@localhost:5433/procurely
# DIRECT_URL: database owner for migrations, seed and the RLS audit.
DIRECT_URL=postgresql://procurely:procurely@localhost:5433/procurely
