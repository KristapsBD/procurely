# Copy to .env.local (gitignored) or export in the shell before starting Metro. Read at bundle time.
# Browser on the same machine as the API:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Physical phone: the LAN address of the Windows host instead (see the README), e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
