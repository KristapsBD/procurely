# Copy to .env.local (gitignored) or export in the shell before starting Metro. Read at bundle time.
# Browser on the same machine as the API:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Physical phone: the WSL address on the tailnet instead (see the README), e.g.
# EXPO_PUBLIC_API_URL=http://100.64.0.1:3000
# Push notifications on a phone need the Expo project id (docs/push-notifications.md):
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
